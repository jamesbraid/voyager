#!/bin/sh
# Check that the files shared by the four reverse-engineering repositories are
# byte-identical to the reference copy.
#
#   tools/check-shared                  verify this clone against tools/shared.sha256
#   tools/check-shared DIR...           also compare each file with the same file in
#                                       the other checkouts DIR (e.g. .cache/siblings/*)
#   tools/check-shared --update         rewrite tools/shared.sha256 after an
#                                       intended change; copy the files and the
#                                       manifest to every repository
#
# The shared files are the container definitions, the wrappers, the Ghidra export helper
# and scripts, this script and
# the scripts every workspace runs the same way (the inventory, the fact sheet,
# the claim checker, its tests, the pre-push hook and the leak check): edit them in one
# repository, run --update, copy the result to the others, and run this in each.
set -eu
cd "$(dirname "$0")/.."
files='tools/Containerfile tools/Containerfile.ghidra tools/re-run tools/setup-clone.sh tools/check-shared
tools/ghidra-export.py tools/ghidra-scripts/ReBSimAdd.java tools/ghidra-scripts/ReDecompileExport.java
tools/ghidra-scripts/ReMipsGp.java tools/ghidra-scripts/ReObjectSymbols.java
scripts/inventory.py scripts/facts.py scripts/check_claims.py scripts/test_facts.py scripts/pre-push scripts/check-leaks.sh
scripts/mdebug.py scripts/test_mdebug.py
tools/ghidra-scripts/ReMdebugImport.java
scripts/syscall_table.py scripts/test_syscall_table.py
scripts/syssgi_selectors.py scripts/test_syssgi_selectors.py
tools/README-analysis.md'
manifest=tools/shared.sha256
if [ "${1:-}" = --update ]; then
    # shellcheck disable=SC2086
    sha256sum $files > "$manifest"
    printf 'wrote %s\n' "$manifest"
    exit 0
fi
bad=0
sha256sum --quiet -c "$manifest" || bad=1
for dir in "$@"; do
    for f in $files $manifest; do
        if ! cmp -s "$f" "$dir/$f"; then
            printf 'differs from %s: %s\n' "$dir" "$f" >&2
            bad=1
        fi
    done
done
[ $bad -eq 0 ] && printf 'shared files match\n'
exit $bad
